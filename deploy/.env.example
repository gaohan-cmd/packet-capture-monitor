# Dashboard public login. Change both before deploying.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-dashboard-password
MONITOR_SESSION_SECRET=change-this-long-random-session-secret

# Shared internal token used by the mitmproxy collector to post captures.
MONITOR_TOKEN=change-this-long-random-capture-token

# Public proxy authentication. Users configure this username/password in their browser proxy settings.
MITMPROXY_PROXY_AUTH=proxyuser:change-this-proxy-password

# Default capture target. It can also be changed from the dashboard after login.
MONITOR_TARGET_URL=https://ikuuu.win
MONITOR_INCLUDE_SUBDOMAINS=1
MONITOR_BODY_LIMIT=2097152

# Use secure cookies when the dashboard is served over HTTPS by Nginx/Caddy.
DASHBOARD_COOKIE_SECURE=1
