# Dashboard users. Prefer DASHBOARD_USERS for multi-user deployments.
# Each user has isolated dashboard data, isolated target config, and separate proxy credentials.
DASHBOARD_USERS=[{"username":"alice","password":"change-this-dashboard-password","proxy_username":"alice-proxy","proxy_password":"change-this-proxy-password","target_url":"https://ikuuu.win","include_subdomains":true},{"username":"bob","password":"change-this-dashboard-password","proxy_username":"bob-proxy","proxy_password":"change-this-proxy-password","target_url":"https://example.com","include_subdomains":true}]

# Legacy single-user fallback. Used only when DASHBOARD_USERS is empty.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
MONITOR_SESSION_SECRET=change-this-long-random-session-secret

# Shared internal token used by the mitmproxy collector to post captures.
MONITOR_TOKEN=change-this-long-random-capture-token

# Legacy single-user proxy authentication. Used only when DASHBOARD_USERS is empty.
MITMPROXY_PROXY_AUTH=

# Default capture target. Multi-user deployments can set per-user target_url in DASHBOARD_USERS.
MONITOR_TARGET_URL=https://ikuuu.win
MONITOR_INCLUDE_SUBDOMAINS=1
MONITOR_BODY_LIMIT=2097152

# Optional build mirrors. Helpful on servers where Docker image builds cannot reliably reach official Debian/PyPI sources.
APT_MIRROR=
APT_SECURITY_MIRROR=
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=

# Use secure cookies when the dashboard is served over HTTPS by Nginx/Caddy.
DASHBOARD_COOKIE_SECURE=1
